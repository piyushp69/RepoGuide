# RepoGuide configuration. Copy to .env (scripts/setup.py does this) and edit as needed.
# Every value is optional; the defaults are shown.

# --- Local models (Ollama). The URL must point to this machine: code never leaves it. ---
OLLAMA_BASE_URL=http://localhost:11434
CHAT_MODEL=qwen2.5-coder:7b
EMBED_MODEL=nomic-embed-text
# Task prefixes for the embedding model. "auto" uses the right ones for nomic-embed-text / mxbai-embed-large.
EMBED_DOC_PREFIX=auto
EMBED_QUERY_PREFIX=auto
# Context window for the chat model. 8192 fits a 7B model in 8 GB of VRAM.
LLM_NUM_CTX=8192
# Sampling temperature for overview/onboarding/quiz generation, and for answers to questions.
LLM_TEMPERATURE=0.1
QA_TEMPERATURE=0.0
# Maximum length of an answer (tokens). Longer answers are cut off with a visible note.
QA_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=300
OLLAMA_KEEP_ALIVE=30m
EMBED_BATCH_SIZE=16

# --- Storage (relative paths are resolved from the repository root) ---
DATA_DIR=data
EVAL_DIR=eval

# --- Ingestion ---
MAX_FILE_SIZE_KB=512
MAX_FILES=5000
GIT_TIMEOUT_SECONDS=600

# --- Chunking ---
CHUNK_MAX_LINES=120
CLASS_INLINE_MAX_LINES=60
WINDOW_LINES=60
WINDOW_OVERLAP=10

# --- Retrieval ---
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATES=25
GRAPH_EXPAND_SEEDS=4
GRAPH_MAX_NEIGHBORS=6
CONTEXT_CHAR_BUDGET=16000
CHAT_HISTORY_TURNS=2

# --- Servers (bound to localhost only) ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173
